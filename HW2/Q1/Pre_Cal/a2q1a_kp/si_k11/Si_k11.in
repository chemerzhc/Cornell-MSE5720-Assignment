&CONTROL
 calculation = 'scf',
 restart_mode = 'from_scratch',
 prefix="Si_k11",
 pseudo_dir='/scratch/11018/zhc/Assisgnment2/Q1/1A/energy_cutoff_test/',
 tstress=.true.,
 tprnfor=.true.,
/
&SYSTEM
 ibrav=2,
 celldm(1)=10.2d0,
 nat=2,
 ntyp=1,
 nbnd=8,
 ecutwfc=30,
 ecutrho=450,
 occupations = 'fixed',
 use_all_frac = .true.,
/
&ELECTRONS
 conv_thr = 1.0D-8,
 mixing_mode = 'plain',
 mixing_beta = 0.7d0,
 diagonalization = 'cg',
/
ATOMIC_SPECIES
Si 28.0855d0 Si_LDA.UPF

ATOMIC_POSITIONS crystal
Si 0.d0 0.d0 0.d0
Si 0.25d0 0.25d0 0.25d0

K_POINTS automatic
 12 12 12 0 0 0
