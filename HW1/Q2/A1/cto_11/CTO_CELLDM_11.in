&CONTROL
 calculation = 'scf',
 restart_mode = 'from_scratch',
 prefix='CTO_CELLDM_11',
 pseudo_dir='/scratch/11018/zhc/assisgnment1/CaTiO3/',
 tstress=.true.,
 tprnfor=.true.,
 disk_io='low',
/
&SYSTEM
 ibrav=1,
celldm(1)=7.6582805d0
 nat=5,
 ntyp=3,
 ecutwfc=100,
 ecutrho=1000,
 occupations = 'fixed'
/
&ELECTRONS
 conv_thr = 1.0D-8,
 mixing_mode = 'plain',
 mixing_beta = 0.7d0,
 diagonalization = 'cg',
/
&IONS
 ion_dynamics='bfgs',
/
&CELL
 cell_dynamics = 'bfgs',
 press=0.d0,
/
ATOMIC_SPECIES
 Ca 40.078d0 Ca_LDA.UPF
 Ti 47.88d0 Ti_LDA.UPF
 O  16.00d0 O_LDA.UPF

ATOMIC_POSITIONS
 Ca 0.d0 0.d0 0.d0
 Ti 0.5d0 0.5d0 0.5d0
 O 0.5d0 0.5d0 0.d0
 O 0.5d0 0.d0 0.5d0
 O 0.d0 0.5d0 0.5d0

K_POINTS automatic
  6 6 6 0 0 0

